---
import Base from '../layouts/Base.astro';
import Cabecalho from '../components/Cabecalho.astro';
import Hero from '../components/Hero.astro';
import Dor from '../components/Dor.astro';
import ComoFunciona from '../components/ComoFunciona.astro';
import Funcionalidades from '../components/Funcionalidades.astro';
import Suporte from '../components/Suporte.astro';
import ProvaSocial from '../components/ProvaSocial.astro';
import Planos from '../components/Planos.astro';
import Faq from '../components/Faq.astro';
import CtaFinal from '../components/CtaFinal.astro';
import Rodape from '../components/Rodape.astro';
import { conteudo } from '../lib/conteudo';
import { SITE, IMAGEM_OG } from '../lib/site';

// Dados estruturados (JSON-LD). O FAQ sai das mesmas perguntas da página.
const dadosEstruturados = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'NotaSimples',
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web',
    description: conteudo.seo.descricao,
    url: SITE.href,
    image: IMAGEM_OG.url,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: conteudo.faq.perguntas.map((p) => ({
      '@type': 'Question',
      name: p.pergunta,
      acceptedAnswer: { '@type': 'Answer', text: p.resposta },
    })),
  },
];
// "<" escapado para o JSON nunca fechar a tag <script> por acidente.
const jsonLd = JSON.stringify(dadosEstruturados).replace(/</g, '\\u003c');
---

<Base title={conteudo.seo.titulo} description={conteudo.seo.descricao}>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />
  <Cabecalho />
  <main>
    <Hero />
    <Dor />
    <ComoFunciona />
    <Funcionalidades />
    <Suporte />
    <ProvaSocial />
    <Planos />
    <Faq />
    <CtaFinal />
  </main>
  <Rodape />
</Base>
