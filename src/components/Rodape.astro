---
import Logo from './Logo.astro';
import Icone from './Icone.astro';
import { conteudo } from '../lib/conteudo';
import { EMAIL, linkWhatsApp } from '../lib/contato';

const { rodape } = conteudo;
const direitos = rodape.direitos.replace('{ano}', String(new Date().getFullYear()));
---

<footer class="rodape">
  <div class="container">
    <div class="rodape-grade">
      <Logo />

      <div class="rodape-contador">
        <h2>{rodape.contador.titulo}</h2>
        <p>{rodape.contador.texto}</p>
        <ul class="rodape-links">
          <li>
            <a href={linkWhatsApp(rodape.contador.whatsapp_mensagem)} target="_blank" rel="noopener">
              <Icone nome="conversa" tamanho={20} />
              WhatsApp
              <span class="sr-only">(abre em nova aba)</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${EMAIL}`}>
              <Icone nome="email" tamanho={20} />
              {EMAIL}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="rodape-base">
      <a href="/privacidade/">{rodape.privacidade}</a>
      <span>{direitos}</span>
    </div>
  </div>
</footer>

<style>
  .rodape {
    padding-block: var(--esp-12) var(--esp-8);
    border-top: 1px solid var(--bege);
  }

  .rodape-grade {
    display: grid;
    gap: var(--esp-8);
    align-items: start;
  }

  .rodape-contador {
    display: grid;
    gap: var(--esp-2);
  }

  .rodape-contador h2 {
    font-size: var(--titulo-3);
  }

  .rodape-contador p {
    color: var(--marrom);
  }

  .rodape-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--esp-2) var(--esp-6);
    margin-top: var(--esp-2);
    padding: 0;
    list-style: none;
  }

  .rodape-links a {
    display: inline-flex;
    align-items: center;
    gap: var(--esp-2);
    min-height: 2.75rem;
    font-weight: 600;
  }

  .rodape-base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--esp-3) var(--esp-6);
    margin-top: var(--esp-12);
    padding-top: var(--esp-6);
    border-top: 1px solid var(--bege);
    font-size: var(--texto-sm);
    color: var(--marrom);
  }

  @media (min-width: 48rem) {
    .rodape-grade {
      grid-template-columns: 1fr auto;
    }

    .rodape-contador {
      max-width: 28rem;
    }
  }
</style>
